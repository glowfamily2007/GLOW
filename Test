<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Setlist Buddy</title>

<style>
:root {
  --bg: #0b0d10;
  --panel: #13171c;
  --panel2: #1a2027;
  --border: #29313a;
  --text: #f4f7fa;
  --muted: #8d98a5;
  --accent: #7c5cff;
  --accent2: #9b83ff;
  --danger: #ff5364;
  --success: #39d98a;
  --shadow: 0 20px 50px rgba(0,0,0,.35);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system,
               BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  display: grid;
  grid-template-columns: 270px 1fr;
  min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
  background: #0f1216;
  border-right: 1px solid var(--border);
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 10px 25px;
}

.logo-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--accent), #bd55ff);
  font-size: 20px;
  box-shadow: 0 8px 25px rgba(124,92,255,.3);
}

.logo strong {
  font-size: 18px;
}

.nav-title {
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 12px 12px 7px;
}

.nav-btn {
  width: 100%;
  border: 0;
  background: transparent;
  color: #cbd2da;
  padding: 11px 12px;
  border-radius: 9px;
  text-align: left;
  margin-bottom: 3px;
}

.nav-btn:hover,
.nav-btn.active {
  background: var(--panel2);
  color: white;
}

.setlists {
  overflow-y: auto;
  flex: 1;
}

.setlist-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 9px 10px;
  border-radius: 8px;
  color: #c8d0d8;
  cursor: pointer;
  margin-bottom: 3px;
}

.setlist-item:hover,
.setlist-item.active {
  background: #1b2027;
  color: white;
}

.setlist-item span:first-child {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delete-setlist {
  opacity: 0;
  color: var(--danger);
  background: none;
  border: 0;
}

.setlist-item:hover .delete-setlist {
  opacity: 1;
}

.sidebar-bottom {
  border-top: 1px solid var(--border);
  padding-top: 15px;
}

/* MAIN */

.main {
  min-width: 0;
}

.topbar {
  height: 74px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  background: rgba(11,13,16,.88);
  backdrop-filter: blur(12px);
  position: sticky;
  top: 0;
  z-index: 20;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.topbar-title {
  font-size: 18px;
  font-weight: 700;
}

.topbar-actions {
  display: flex;
  gap: 8px;
}

.content {
  max-width: 1100px;
  margin: auto;
  padding: 35px 30px 80px;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 25px;
}

.hero h1 {
  margin: 0 0 8px;
  font-size: clamp(28px, 5vw, 42px);
  letter-spacing: -1.5px;
}

.hero p {
  margin: 0;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

/* BUTTONS */

.btn {
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text);
  padding: 10px 14px;
  border-radius: 9px;
  transition: .15s;
}

.btn:hover {
  background: var(--panel2);
  transform: translateY(-1px);
}

.btn.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: white;
}

.btn.primary:hover {
  background: var(--accent2);
}

.btn.danger {
  color: #ff7180;
}

.btn.small {
  padding: 7px 10px;
  font-size: 13px;
}

/* CARDS */

.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow);
}

.setlist-header {
  padding: 20px;
  display: grid;
  grid-template-columns: 1fr 180px;
  gap: 15px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.field label {
  font-size: 12px;
  color: var(--muted);
}

input,
textarea,
select {
  width: 100%;
  background: #0e1115;
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 11px 12px;
  outline: none;
}

input:focus,
textarea:focus,
select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(124,92,255,.12);
}

textarea {
  min-height: 90px;
  resize: vertical;
}

.searchbar {
  display: flex;
  gap: 8px;
  padding: 15px 20px;
  border-top: 1px solid var(--border);
}

.searchbar input {
  flex: 1;
}

/* SONGS */

.song-list {
  padding: 8px;
}

.song {
  display: grid;
  grid-template-columns: 34px 42px 1fr auto;
  align-items: center;
  gap: 10px;
  padding: 13px 12px;
  border-radius: 10px;
  margin-bottom: 4px;
  background: transparent;
  border: 1px solid transparent;
  transition: .15s;
}

.song:hover {
  background: var(--panel2);
  border-color: var(--border);
}

.song.dragging {
  opacity: .4;
}

.drag {
  color: #68737f;
  cursor: grab;
  font-size: 18px;
  text-align: center;
}

.number {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  background: #20262d;
  color: #adb7c1;
  font-size: 13px;
}

.song-main {
  min-width: 0;
}

.song-title {
  font-weight: 700;
  margin-bottom: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-meta {
  color: var(--muted);
  font-size: 13px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.song-actions {
  display: flex;
  gap: 5px;
}

.icon-btn {
  border: 0;
  background: transparent;
  color: #8e99a5;
  width: 34px;
  height: 34px;
  border-radius: 7px;
}

.icon-btn:hover {
  background: #272e36;
  color: white;
}

.icon-btn.delete:hover {
  color: var(--danger);
}

/* EMPTY */

.empty {
  text-align: center;
  padding: 65px 20px;
  color: var(--muted);
}

.empty-icon {
  font-size: 42px;
  margin-bottom: 15px;
}

/* STATS */

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 18px;
}

.stat {
  padding: 18px;
}

.stat-value {
  font-size: 25px;
  font-weight: 800;
}

.stat-label {
  font-size: 12px;
  color: var(--muted);
  margin-top: 3px;
}

/* MODAL */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.7);
  backdrop-filter: blur(6px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 20px;
}

.modal-overlay.show {
  display: flex;
}

.modal {
  width: min(550px, 100%);
  background: #151a20;
  border: 1px solid var(--border);
  border-radius: 15px;
  box-shadow: 0 30px 100px rgba(0,0,0,.6);
  overflow: hidden;
}

.modal-head {
  padding: 18px 20px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-head h2 {
  margin: 0;
  font-size: 18px;
}

.modal-body {
  padding: 20px;
  display: grid;
  gap: 15px;
}

.modal-foot {
  padding: 15px 20px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

/* PERFORMANCE */

.performance {
  position: fixed;
  inset: 0;
  background: #050608;
  z-index: 200;
  display: none;
  flex-direction: column;
}

.performance.show {
  display: flex;
}

.performance-head {
  padding: 20px 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #22272e;
}

.performance-body {
  flex: 1;
  display: grid;
  place-items: center;
  text-align: center;
  padding: 30px;
}

.performance-number {
  color: var(--accent2);
  font-size: 20px;
  margin-bottom: 20px;
}

.performance-title {
  font-size: clamp(40px, 9vw, 100px);
  font-weight: 900;
  letter-spacing: -3px;
}

.performance-meta {
  color: var(--muted);
  font-size: 20px;
  margin-top: 15px;
}

.performance-nav {
  display: flex;
  justify-content: center;
  gap: 10px;
  padding: 20px;
}

/* TOAST */

.toast {
  position: fixed;
  right: 20px;
  bottom: 20px;
  background: #1c232b;
  border: 1px solid var(--border);
  padding: 12px 16px;
  border-radius: 9px;
  box-shadow: var(--shadow);
  transform: translateY(100px);
  opacity: 0;
  transition: .25s;
  z-index: 500;
}

.toast.show {
  transform: translateY(0);
  opacity: 1;
}

/* LIGHT MODE */

body.light {
  --bg: #f5f7fa;
  --panel: #ffffff;
  --panel2: #edf0f4;
  --border: #dce1e7;
  --text: #15191e;
  --muted: #697482;
}

body.light .sidebar,
body.light .topbar {
  background: #fff;
}

body.light input,
body.light textarea,
body.light select {
  background: #f7f8fa;
}

body.light .number {
  background: #edf0f4;
}

/* MOBILE */

.mobile-menu {
  display: none;
}

@media (max-width: 800px) {
  .app {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 280px;
    z-index: 150;
    transform: translateX(-100%);
    transition: .25s;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .mobile-menu {
    display: inline-flex;
  }

  .topbar {
    padding: 0 15px;
  }

  .content {
    padding: 25px 15px 60px;
  }

  .hero {
    flex-direction: column;
  }

  .setlist-header {
    grid-template-columns: 1fr;
  }

  .song {
    grid-template-columns: 25px 34px 1fr;
  }

  .song-actions {
    grid-column: 3;
  }

  .stats {
    grid-template-columns: 1fr 1fr;
  }
}

/* PRINT */

@media print {
  body {
    background: white;
    color: black;
  }

  .sidebar,
  .topbar,
  .hero-actions,
  .searchbar,
  .song-actions,
  .drag,
  .stats,
  .modal-overlay {
    display: none !important;
  }

  .app {
    display: block;
  }

  .content {
    max-width: none;
    padding: 0;
  }

  .card {
    border: 0;
    box-shadow: none;
  }

  .song {
    border-bottom: 1px solid #ddd;
    border-radius: 0;
    padding: 12px 0;
  }

  .number {
    background: #eee;
    color: #111;
  }

  .song-title {
    color: #111;
  }

  .song-meta {
    color: #555;
  }
}
</style>
</head>

<body>

<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">

    <div class="logo">
      <div class="logo-icon">🎵</div>
      <strong>Setlist Buddy</strong>
    </div>

    <button class="nav-btn active" onclick="showSetlists()">
      📋 Setlists
    </button>

    <button class="nav-btn" onclick="newSetlist()">
      ＋ New Setlist
    </button>

    <div class="nav-title">Your Setlists</div>

    <div class="setlists" id="setlists"></div>

    <div class="sidebar-bottom">
      <button class="nav-btn" onclick="toggleTheme()">
        🌓 Toggle Theme
      </button>

      <button class="nav-btn" onclick="exportData()">
        💾 Export Data
      </button>

      <button class="nav-btn" onclick="importData()">
        📥 Import Data
      </button>
    </div>

  </aside>

  <!-- MAIN -->
  <main class="main">

    <header class="topbar">

      <div class="topbar-left">
        <button class="btn mobile-menu" onclick="toggleSidebar()">☰</button>
        <div class="topbar-title" id="topTitle">Setlist Buddy</div>
      </div>

      <div class="topbar-actions">
        <button class="btn small" onclick="openPerformance()">
          🎤 Perform
        </button>

        <button class="btn small" onclick="window.print()">
          🖨 Print
        </button>
      </div>

    </header>

    <section class="content">

      <div class="hero">

        <div>
          <h1 id="pageTitle">My Setlist</h1>
          <p id="pageDescription">Build your perfect show.</p>
        </div>

        <div class="hero-actions">
          <button class="btn" onclick="duplicateSetlist()">
            Duplicate
          </button>

          <button class="btn primary" onclick="openSongModal()">
            ＋ Add Song
          </button>
        </div>

      </div>

      <!-- STATS -->
      <div class="stats">

        <div class="card stat">
          <div class="stat-value" id="songCount">0</div>
          <div class="stat-label">Songs</div>
        </div>

        <div class="card stat">
          <div class="stat-value" id="totalTime">0m</div>
          <div class="stat-label">Estimated Runtime</div>
        </div>

        <div class="card stat">
          <div class="stat-value" id="setlistCount">0</div>
          <div class="stat-label">Setlists</div>
        </div>

      </div>

      <!-- SETLIST CARD -->
      <div class="card">

        <div class="setlist-header">

          <div class="field">
            <label>SETLIST NAME</label>
            <input
              id="setlistName"
              placeholder="e.g. Friday Night Show"
              oninput="updateSetlistName(this.value)"
            >
          </div>

          <div class="field">
            <label>VENUE / EVENT</label>
            <input
              id="venue"
              placeholder="e.g. The Roxy"
              oninput="updateVenue(this.value)"
            >
          </div>

        </div>

        <div class="searchbar">
          <input
            id="search"
            placeholder="Search songs..."
            oninput="renderSongs()"
          >

          <button class="btn" onclick="clearSearch()">
            Clear
          </button>
        </div>

        <div class="song-list" id="songList"></div>

      </div>

      <div class="field" style="margin-top:20px;">
        <label>NOTES</label>
        <textarea
          id="notes"
          placeholder="Show notes, announcements, tuning changes..."
          oninput="updateNotes(this.value)"
        ></textarea>
      </div>

    </section>

  </main>

</div>

<!-- SONG MODAL -->

<div class="modal-overlay" id="songModal">

  <div class="modal">

    <div class="modal-head">
      <h2 id="modalTitle">Add Song</h2>
      <button class="icon-btn" onclick="closeSongModal()">✕</button>
    </div>

    <div class="modal-body">

      <div class="field">
        <label>SONG TITLE</label>
        <input id="songTitleInput" placeholder="Song title">
      </div>

      <div class="field">
        <label>ARTIST</label>
        <input id="artistInput" placeholder="Artist">
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">

        <div class="field">
          <label>KEY</label>
          <input id="keyInput" placeholder="e.g. G">
        </div>

        <div class="field">
          <label>BPM</label>
          <input id="bpmInput" type="number" placeholder="120">
        </div>

      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">

        <div class="field">
          <label>DURATION (MINUTES)</label>
          <input id="durationInput" type="number" step="0.5" placeholder="4">
        </div>

        <div class="field">
          <label>COLOR</label>
          <select id="colorInput">
            <option value="#7c5cff">Purple</option>
            <option value="#39d98a">Green</option>
            <option value="#ffb84d">Orange</option>
            <option value="#ff5364">Red</option>
            <option value="#35a7ff">Blue</option>
          </select>
        </div>

      </div>

      <div class="field">
        <label>NOTES</label>
        <textarea
          id="songNotesInput"
          placeholder="Special instructions..."
        ></textarea>
      </div>

    </div>

    <div class="modal-foot">
      <button class="btn" onclick="closeSongModal()">Cancel</button>
      <button class="btn primary" onclick="saveSong()">Save Song</button>
    </div>

  </div>

</div>

<!-- PERFORMANCE MODE -->

<div class="performance" id="performance">

  <div class="performance-head">

    <div>
      <strong id="performanceSetlist">Setlist</strong>
      <div style="color:#737e89;font-size:13px;" id="performanceVenue"></div>
    </div>

    <button class="btn" onclick="closePerformance()">Exit</button>

  </div>

  <div class="performance-body">

    <div>

      <div class="performance-number" id="performanceNumber">
        1 / 1
      </div>

      <div class="performance-title" id="performanceTitle">
        No Songs
      </div>

      <div class="performance-meta" id="performanceMeta">
        —
      </div>

    </div>

  </div>

  <div class="performance-nav">

    <button class="btn" onclick="previousPerformance()">
      ← Previous
    </button>

    <button class="btn primary" onclick="nextPerformance()">
      Next →
    </button>

  </div>

</div>

<div class="toast" id="toast"></div>

<script>
/* ============================================================
   SETLIST BUDDY
   Standalone setlist manager
   ============================================================ */

const STORAGE_KEY = "setlist_buddy_data_v1";

let data = {
  setlists: [],
  activeId: null,
  theme: "dark"
};

let editingSongId = null;
let performanceIndex = 0;
let draggedSongId = null;

/* -----------------------------
   INITIALIZATION
----------------------------- */

function init() {

  const saved = localStorage.getItem(STORAGE_KEY);

  if (saved) {
    try {
      data = JSON.parse(saved);
    } catch {
      createDefaultData();
    }
  }

  if (!data.setlists || !data.setlists.length) {
    createDefaultData();
  }

  if (!data.activeId) {
    data.activeId = data.setlists[0].id;
  }

  applyTheme();
  renderAll();
}

function createDefaultData() {

  const id = uid();

  data = {
    theme: "dark",
    activeId: id,
    setlists: [
      {
        id,
        name: "My First Setlist",
        venue: "",
        notes: "",
        songs: [
          {
            id: uid(),
            title: "Example Song",
            artist: "Your Artist",
            key: "G",
            bpm: 120,
            duration: 4,
            color: "#7c5cff",
            notes: ""
          }
        ]
      }
    ]
  };

  save();
}

/* -----------------------------
   HELPERS
----------------------------- */

function uid() {
  return Date.now().toString(36) +
         Math.random().toString(36).slice(2);
}

function activeSetlist() {
  return data.setlists.find(s => s.id === data.activeId);
}

function save() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
}

function escapeHTML(value) {

  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function showToast(message) {

  const toast = document.getElementById("toast");

  toast.textContent = message;
  toast.classList.add("show");

  clearTimeout(window.toastTimer);

  window.toastTimer = setTimeout(() => {
    toast.classList.remove("show");
  }, 2200);
}

/* -----------------------------
   RENDER
----------------------------- */

function renderAll() {
  renderSidebar();
  renderHeader();
  renderSongs();
  renderStats();
  renderFields();
}

function renderSidebar() {

  const container = document.getElementById("setlists");

  container.innerHTML = data.setlists.map(setlist => `

    <div
      class="setlist-item ${setlist.id === data.activeId ? "active" : ""}"
      onclick="selectSetlist('${setlist.id}')"
    >

      <span>📄 ${escapeHTML(setlist.name || "Untitled")}</span>

      <button
        class="delete-setlist"
        onclick="event.stopPropagation();deleteSetlist('${setlist.id}')"
        title="Delete"
      >
        ×
      </button>

    </div>

  `).join("");

  document.getElementById("setlistCount").textContent =
    data.setlists.length;
}

function renderHeader() {

  const setlist = activeSetlist();

  if (!setlist) return;

  document.getElementById("topTitle").textContent =
    setlist.name || "Untitled Setlist";

  document.getElementById("pageTitle").textContent =
    setlist.name || "Untitled Setlist";

  document.getElementById("pageDescription").textContent =
    setlist.venue
      ? setlist.venue
      : "Build your perfect show.";
}

function renderFields() {

  const setlist = activeSetlist();

  if (!setlist) return;

  document.getElementBy
